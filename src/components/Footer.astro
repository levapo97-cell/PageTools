---
import { SITE, FOOTER_LINKS, LEGAL_LINKS } from '@/consts';
import Newsletter from './Newsletter.astro';

const year = new Date().getFullYear();
const groups = Object.entries(FOOTER_LINKS);
---

<footer class="mt-24 border-t border-border-subtle bg-surface-muted">
  <div class="container-page py-14">
    <div class="grid gap-12 lg:grid-cols-[1.4fr_1fr_1fr_1.6fr]">
      <div>
        <a href="/" class="flex items-center gap-2.5 font-extrabold tracking-tight">
          <span
            class="grid size-8 place-items-center rounded-lg bg-brand-600 text-white dark:bg-brand-500"
            aria-hidden="true"
          >
            <svg class="size-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 7h16M4 12h10M4 17h7"></path>
              <path d="m16 15 2.5 2.5L23 13"></path>
            </svg>
          </span>
          <span class="text-lg text-ink">DevTool<span class="text-accent">SDK</span></span>
        </a>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-ink-muted">{SITE.description}</p>
      </div>

      {groups.map(([group, links]) => (
        <nav aria-label={group}>
          <h2 class="text-xs font-bold uppercase tracking-wider text-ink">{group}</h2>
          <ul class="mt-4 space-y-2.5">
            {links.map((link) => (
              <li>
                <a href={link.href} class="text-sm text-ink-muted transition-colors hover:text-accent">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))}

      <div>
        <h2 class="text-xs font-bold uppercase tracking-wider text-ink">Newsletter</h2>
        <div class="mt-4">
          <Newsletter compact />
        </div>
      </div>
    </div>

    <div
      class="mt-12 flex flex-col gap-4 border-t border-border-subtle pt-6 text-sm text-ink-muted sm:flex-row sm:items-center sm:justify-between"
    >
      <div>
        <p>© {year} {SITE.name}. All rights reserved.</p>
        <ul class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1">
          {LEGAL_LINKS.map((link) => (
            <li>
              <a href={link.href} class="transition-colors hover:text-accent">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>
      <p class="max-w-xl text-xs leading-relaxed">
        DevToolSDK is funded by display advertising and by affiliate links, which are marked
        wherever they appear. Neither has ever influenced a rating — our
        <a href="/about#methodology" class="underline underline-offset-2 hover:text-accent">methodology</a>
        explains how we score, and our
        <a href="/disclosure" class="underline underline-offset-2 hover:text-accent">disclosure</a>
        explains how we are paid.
      </p>
    </div>
  </div>
</footer>
