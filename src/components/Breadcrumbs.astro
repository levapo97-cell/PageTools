---
interface Crumb {
  href?: string;
  label: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;

---

<nav aria-label="Breadcrumb" class="text-sm">
  <ol class="flex flex-wrap items-center gap-1.5 text-ink-muted">
    {items.map((item, index) => (
      <li class="flex items-center gap-1.5">
        {index > 0 && <span aria-hidden="true" class="text-border-strong">/</span>}
        {item.href ? (
          <a href={item.href} class="transition-colors hover:text-accent">{item.label}</a>
        ) : (
          <span class="font-medium text-ink" aria-current="page">{item.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
