---
interface Row {
  feature: string;
  a: string;
  b: string;
  winner: 'a' | 'b' | 'tie';
}

interface Props {
  /** Column headers — normally the two tool names. */
  columns: [string, string];
  rows: Row[];
  caption?: string;
  class?: string;
}

const { columns, rows, caption, class: className = '' } = Astro.props;
const [colA, colB] = columns;

const cellClass = (winner: Row['winner'], side: 'a' | 'b') =>
  winner === side
    ? 'bg-accent-soft/60 font-semibold text-ink'
    : 'text-ink-muted';
---

<figure class={`not-prose my-8 ${className}`}>
  <div class="overflow-x-auto rounded-[var(--radius-card)] border border-border-subtle">
    <table class="w-full min-w-[34rem] border-collapse text-left text-sm">
      <caption class="sr-only">{caption ?? `${colA} compared with ${colB}`}</caption>
      <thead>
        <tr class="bg-surface-muted">
          <th scope="col" class="px-4 py-3.5 font-bold text-ink">Feature</th>
          <th scope="col" class="px-4 py-3.5 font-bold text-ink">{colA}</th>
          <th scope="col" class="px-4 py-3.5 font-bold text-ink">{colB}</th>
        </tr>
      </thead>
      <tbody>
        {rows.map((row) => (
          <tr class="border-t border-border-subtle align-top">
            <th scope="row" class="px-4 py-3.5 font-semibold text-ink">{row.feature}</th>
            <td class={`px-4 py-3.5 ${cellClass(row.winner, 'a')}`}>
              {row.winner === 'a' && <span class="mr-1.5 text-accent" aria-label="Winner">✔</span>}
              {row.a}
            </td>
            <td class={`px-4 py-3.5 ${cellClass(row.winner, 'b')}`}>
              {row.winner === 'b' && <span class="mr-1.5 text-accent" aria-label="Winner">✔</span>}
              {row.b}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  {caption && (
    <figcaption class="mt-2.5 text-xs text-ink-muted">{caption}</figcaption>
  )}
</figure>
