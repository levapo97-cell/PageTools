---
import type { Guide } from '@/lib/content';
import Badge from './Badge.astro';

interface Props {
  guide: Guide;
}

const { guide } = Astro.props;
const { tool, sections } = guide;

const difficultyVariant = {
  Beginner: 'success',
  Intermediate: 'warning',
  Advanced: 'brand',
} as const;
---

<article
  class="group card-surface flex flex-col p-6 transition-all duration-200 hover:-translate-y-0.5 hover:border-accent/40 hover:shadow-[var(--shadow-card-hover)]"
>
  <a href={`/guides/${tool.slug}`} class="flex h-full flex-col focus-visible:outline-none">
    <div class="flex items-start justify-between gap-3">
      <div>
        <Badge variant="neutral">{tool.category}</Badge>
        <h3 class="mt-3 text-xl font-extrabold tracking-tight text-ink transition-colors group-hover:text-accent">
          {tool.name}
        </h3>
        <p class="mt-1 text-sm font-medium text-ink-muted">{tool.tagline}</p>
      </div>
      <Badge variant={difficultyVariant[tool.difficulty]}>{tool.difficulty}</Badge>
    </div>

    <p class="mt-4 flex-1 text-sm leading-relaxed text-ink-muted">{tool.description}</p>

    <dl class="mt-5 flex flex-wrap gap-x-5 gap-y-1.5 border-t border-border-subtle pt-4 text-xs text-ink-muted">
      <div class="flex gap-1.5">
        <dt class="font-semibold text-ink">{sections.length}</dt>
        <dd>chapters</dd>
      </div>
      <div class="flex gap-1.5">
        <dt class="font-semibold text-ink">~{tool.duration}</dt>
        <dd>min</dd>
      </div>
      <div class="flex gap-1.5">
        <dt class="font-semibold text-ink">v{tool.version}</dt>
        <dd>covered</dd>
      </div>
    </dl>

    <span class="mt-4 text-sm font-semibold text-accent">Start the guide →</span>
  </a>
</article>
