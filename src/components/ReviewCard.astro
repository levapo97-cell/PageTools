---
import { Image } from 'astro:assets';
import type { Review } from '@/lib/content';
import { formatDate } from '@/lib/format';
import RatingStars from './RatingStars.astro';
import Badge from './Badge.astro';

interface Props {
  review: Review;
  featured?: boolean;
}

const { review, featured = false } = Astro.props;
const { title, description, category, rating, pubDate, tools, image, imageAlt } = review.data;
const href = `/reviews/${review.id}`;
const versus = tools.map((tool) => tool.name);
---

<article
  class:list={[
    'group card-surface flex flex-col overflow-hidden transition-all duration-200 hover:-translate-y-0.5 hover:border-accent/40 hover:shadow-[var(--shadow-card-hover)]',
    featured && 'sm:col-span-2 lg:col-span-1',
  ]}
>
  <a href={href} class="flex h-full flex-col focus-visible:outline-none">
    {image ? (
      <Image src={image} alt={imageAlt ?? title} widths={[400, 800]} class="aspect-16/9 w-full object-cover" />
    ) : (
      <div
        class="relative flex aspect-16/9 items-center justify-center overflow-hidden bg-gradient-to-br from-brand-700 via-brand-600 to-brand-900"
        aria-hidden="true"
      >
        <div class="absolute inset-0 opacity-25 hero-grid"></div>
        <p class="relative flex items-center gap-3 px-4 text-center font-extrabold tracking-tight text-white">
          {versus.map((name, index) => (
            <>
              {index > 0 && (
                <span class="rounded-full bg-white/15 px-2 py-0.5 text-[0.65rem] uppercase tracking-widest">
                  vs
                </span>
              )}
              <span class="text-base sm:text-lg">{name}</span>
            </>
          ))}
        </p>
      </div>
    )}

    <div class="flex flex-1 flex-col p-5">
      <div class="flex items-center justify-between gap-3">
        <Badge variant="brand">{category}</Badge>
        <RatingStars rating={rating} size="sm" />
      </div>

      <h3
        class="mt-3 text-lg font-bold leading-snug text-balance text-ink transition-colors group-hover:text-accent"
      >
        {title}
      </h3>

      <p class="mt-2 line-clamp-3 flex-1 text-sm leading-relaxed text-ink-muted">{description}</p>

      <div class="mt-4 flex items-center justify-between border-t border-border-subtle pt-4 text-xs text-ink-muted">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        <span class="font-semibold text-accent">Read the comparison →</span>
      </div>
    </div>
  </a>
</article>
