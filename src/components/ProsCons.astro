---
import RatingStars from './RatingStars.astro';

interface Tool {
  name: string;
  vendor?: string;
  url?: string;
  rating: number;
  pricing: string;
  bestFor: string;
  pros: string[];
  cons: string[];
}

interface Props {
  tools: Tool[];
}

const { tools } = Astro.props;
---

<div class="not-prose my-8 grid gap-5 md:grid-cols-2">
  {tools.map((tool) => (
    <section class="card-surface flex flex-col p-5">
      <header class="flex items-start justify-between gap-3">
        <div>
          <h3 class="text-lg font-bold text-ink">
            {tool.url ? (
              <a href={tool.url} rel="noopener noreferrer nofollow" target="_blank" class="hover:text-accent">
                {tool.name}
              </a>
            ) : (
              tool.name
            )}
          </h3>
          {tool.vendor && <p class="text-xs text-ink-muted">by {tool.vendor}</p>}
        </div>
        <RatingStars rating={tool.rating} size="sm" />
      </header>

      <dl class="mt-4 grid grid-cols-1 gap-2 border-y border-border-subtle py-3 text-sm sm:grid-cols-[auto_1fr] sm:gap-x-4">
        <dt class="font-semibold text-ink">Pricing</dt>
        <dd class="text-ink-muted">{tool.pricing}</dd>
        <dt class="font-semibold text-ink">Best for</dt>
        <dd class="text-ink-muted">{tool.bestFor}</dd>
      </dl>

      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        <div>
          <h4 class="flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400">
            <span aria-hidden="true">＋</span> Pros
          </h4>
          <ul class="mt-2 space-y-1.5 text-sm text-ink-muted">
            {tool.pros.map((pro) => (
              <li class="flex gap-2">
                <span class="mt-0.5 text-emerald-500" aria-hidden="true">✔</span>
                <span>{pro}</span>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h4 class="flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-rose-600 dark:text-rose-400">
            <span aria-hidden="true">－</span> Cons
          </h4>
          <ul class="mt-2 space-y-1.5 text-sm text-ink-muted">
            {tool.cons.map((con) => (
              <li class="flex gap-2">
                <span class="mt-0.5 text-rose-500" aria-hidden="true">✕</span>
                <span>{con}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  ))}
</div>
