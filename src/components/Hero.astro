---
import CTAButton from './CTAButton.astro';

interface Props {
  guideCount: number;
  chapterCount: number;
  articleCount: number;
}

const { guideCount, chapterCount, articleCount } = Astro.props;

const stats = [
  { value: `${guideCount}`, label: 'Tool guides' },
  { value: `${chapterCount}`, label: 'Chapters, written in order' },
  { value: `${articleCount}`, label: 'Deep dives' },
];
---

<section class="relative isolate overflow-hidden border-b border-border-subtle">
  <div class="absolute inset-0 -z-10 hero-grid" aria-hidden="true"></div>
  <div
    class="absolute inset-x-0 top-0 -z-10 h-80 bg-gradient-to-b from-accent-soft/70 to-transparent"
    aria-hidden="true"
  >
  </div>

  <div class="container-page py-20 sm:py-28">
    <div class="mx-auto max-w-3xl text-center">
      <p
        class="inline-flex items-center gap-2 rounded-full border border-border-subtle bg-surface-raised px-3.5 py-1.5 text-xs font-semibold text-ink-muted shadow-sm"
      >
        <span class="size-1.5 rounded-full bg-emerald-500" aria-hidden="true"></span>
        Free · No signup · No "subscribe to continue"
      </p>

      <h1
        class="mt-6 text-4xl font-extrabold leading-[1.1] tracking-tight text-balance text-ink sm:text-5xl lg:text-6xl"
      >
        Learn the tool properly
        <span class="text-accent">the first time</span>
      </h1>

      <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-pretty text-ink-muted">
        Most tutorials teach you commands. These guides teach you the mental model first — what
        problem the tool solves, and why its design makes sense — so the commands stop needing to
        be memorised.
      </p>

      <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <CTAButton href="/guides" size="lg" event="hero_primary">Browse the guides</CTAButton>
        <CTAButton href="/guides/docker" variant="secondary" size="lg" event="hero_secondary">
          Start with Docker
        </CTAButton>
      </div>

      <dl class="mx-auto mt-14 grid max-w-lg grid-cols-3 gap-6">
        {stats.map((stat) => (
          <div class="text-center">
            <dt class="sr-only">{stat.label}</dt>
            <dd>
              <span class="block text-3xl font-extrabold tracking-tight text-ink">{stat.value}</span>
              <span class="mt-1 block text-xs leading-snug text-ink-muted">{stat.label}</span>
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>
