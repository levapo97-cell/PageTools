---
interface Props {
  type?: 'note' | 'tip' | 'warning' | 'danger';
  title?: string;
}

const { type = 'note', title } = Astro.props;

const variants = {
  note: {
    label: 'Note',
    box: 'border-brand-500/35 bg-brand-500/8',
    accent: 'text-brand-600 dark:text-brand-400',
    icon: 'M12 16v-4M12 8h.01M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z',
  },
  tip: {
    label: 'Tip',
    box: 'border-emerald-500/35 bg-emerald-500/8',
    accent: 'text-emerald-600 dark:text-emerald-400',
    icon: 'M9 18h6M10 22h4M12 2a7 7 0 0 0-4 12.7V17h8v-2.3A7 7 0 0 0 12 2Z',
  },
  warning: {
    label: 'Watch out',
    box: 'border-amber-500/35 bg-amber-500/8',
    accent: 'text-amber-600 dark:text-amber-400',
    icon: 'M12 9v4M12 17h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z',
  },
  danger: {
    label: 'This will break things',
    box: 'border-rose-500/35 bg-rose-500/8',
    accent: 'text-rose-600 dark:text-rose-400',
    icon: 'M12 8v4M12 16h.01M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z',
  },
} as const;

const variant = variants[type];
---

<aside class={`not-prose my-6 rounded-[var(--radius-card)] border px-5 py-4 ${variant.box}`}>
  <p class={`flex items-center gap-2 text-sm font-bold ${variant.accent}`}>
    <svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d={variant.icon}></path>
    </svg>
    {title ?? variant.label}
  </p>
  <div class="mt-2 text-sm leading-relaxed text-ink-muted [&>*+*]:mt-3 [&_a]:text-accent [&_a]:underline [&_a]:underline-offset-2 [&_code]:rounded [&_code]:bg-surface-muted [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:text-[0.85em]">
    <slot />
  </div>
</aside>
