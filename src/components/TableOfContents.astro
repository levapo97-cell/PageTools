---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;
// Only h2/h3 — deeper levels make the rail unreadable on mobile.
const items = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

{items.length > 2 && (
  <nav aria-label="Table of contents" class="not-prose card-surface mb-10 p-5 lg:sticky lg:top-24">
    <h2 class="text-xs font-bold uppercase tracking-[0.18em] text-ink">On this page</h2>
    <ul class="mt-3 space-y-1.5 text-sm">
      {items.map((heading) => (
        <li class={heading.depth === 3 ? 'pl-4' : ''}>
          <a
            href={`#${heading.slug}`}
            class="block text-ink-muted transition-colors hover:text-accent"
          >
            {heading.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}
