---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  external?: boolean;
  class?: string;
  /** Sent to the dataLayer so Google Ads / Analytics can attribute the click. */
  event?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  external = false,
  class: className = '',
  event,
} = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 rounded-lg font-semibold transition-all duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 disabled:opacity-60';

const variants = {
  primary:
    'bg-brand-600 text-white shadow-sm hover:bg-brand-800 hover:shadow-md active:translate-y-px dark:bg-brand-500 dark:hover:bg-brand-400 dark:hover:text-brand-950',
  secondary:
    'border border-border-strong bg-surface-raised text-ink hover:border-accent hover:text-accent',
  ghost: 'text-accent hover:text-accent-hover hover:underline underline-offset-4',
} as const;

const sizes = {
  sm: 'px-3.5 py-2 text-sm',
  md: 'px-5 py-2.5 text-sm sm:text-base',
  lg: 'px-7 py-3.5 text-base',
} as const;

const classes = [base, variants[variant], variant === 'ghost' ? '' : sizes[size], className]
  .filter(Boolean)
  .join(' ');
---

<a
  href={href}
  class={classes}
  data-cta-event={event}
  {...external ? { target: '_blank', rel: 'noopener noreferrer nofollow sponsored' } : {}}
>
  <slot />
  {external && (
    <svg class="size-3.5 opacity-70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M7 17 17 7M9 7h8v8"></path>
    </svg>
  )}
</a>
