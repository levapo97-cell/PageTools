---
import type { GuideSection } from '@/lib/content';
import { pathOf } from '@/lib/content';

interface Props {
  prev?: GuideSection;
  next?: GuideSection;
  /** Shown as the "next" target when the section is the last one. */
  overviewHref: string;
}

const { prev, next, overviewHref } = Astro.props;
---

<nav aria-label="Guide navigation" class="not-prose mt-14 grid gap-4 border-t border-border-subtle pt-8 sm:grid-cols-2">
  {prev ? (
    <a
      href={pathOf(prev)}
      rel="prev"
      class="group card-surface p-4 transition-colors hover:border-accent/40"
    >
      <span class="flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-ink-muted">
        <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m15 18-6-6 6-6"></path>
        </svg>
        Previous
      </span>
      <span class="mt-1.5 block font-semibold text-ink transition-colors group-hover:text-accent">
        {prev.data.title}
      </span>
    </a>
  ) : (
    <span class="hidden sm:block"></span>
  )}

  {next ? (
    <a
      href={pathOf(next)}
      rel="next"
      class="group card-surface p-4 text-right transition-colors hover:border-accent/40"
    >
      <span class="flex items-center justify-end gap-1.5 text-xs font-semibold uppercase tracking-wider text-ink-muted">
        Next
        <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m9 18 6-6-6-6"></path>
        </svg>
      </span>
      <span class="mt-1.5 block font-semibold text-ink transition-colors group-hover:text-accent">
        {next.data.title}
      </span>
    </a>
  ) : (
    <a
      href={overviewHref}
      class="group card-surface p-4 text-right transition-colors hover:border-accent/40"
    >
      <span class="block text-xs font-semibold uppercase tracking-wider text-ink-muted">
        You finished the guide
      </span>
      <span class="mt-1.5 block font-semibold text-ink transition-colors group-hover:text-accent">
        Back to the overview
      </span>
    </a>
  )}
</nav>
