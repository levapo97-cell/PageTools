---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
  class?: string;
}

const { eyebrow, title, description, align = 'left', class: className = '' } = Astro.props;
const alignment = align === 'center' ? 'text-center mx-auto max-w-2xl' : '';
---

<div class={`${alignment} ${className}`}>
  {eyebrow && (
    <p class="text-xs font-bold uppercase tracking-[0.18em] text-accent">{eyebrow}</p>
  )}
  <h2 class="mt-2 text-2xl font-extrabold tracking-tight text-balance text-ink sm:text-3xl">
    {title}
  </h2>
  {description && (
    <p class="mt-3 text-base leading-relaxed text-pretty text-ink-muted">{description}</p>
  )}
</div>
