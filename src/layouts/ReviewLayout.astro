---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import ComparisonTable from '@/components/ComparisonTable.astro';
import ProsCons from '@/components/ProsCons.astro';
import VerdictBox from '@/components/VerdictBox.astro';
import RatingStars from '@/components/RatingStars.astro';
import AdSlot from '@/components/AdSlot.astro';
import Newsletter from '@/components/Newsletter.astro';
import Badge from '@/components/Badge.astro';
import ReviewCard from '@/components/ReviewCard.astro';
import CTAButton from '@/components/CTAButton.astro';
import { formatDate, readingTime } from '@/lib/format';
import { articleSchema, breadcrumbSchema, reviewSchemas } from '@/lib/schema';
import type { Review } from '@/lib/content';

interface Props {
  review: Review;
  headings: MarkdownHeading[];
  related: Review[];
}

const { review, headings, related } = Astro.props;
const {
  title,
  description,
  category,
  tags,
  pubDate,
  updatedDate,
  author,
  rating,
  verdict,
  summary,
  tools,
  comparison,
} = review.data;

const path = `/reviews/${review.id}`;
const minutes = readingTime(review.body);
const columns: [string, string] = [tools[0]?.name ?? 'Option A', tools[1]?.name ?? 'Option B'];

const crumbs = [
  { href: '/', label: 'Home' },
  { href: '/reviews', label: 'Reviews' },
  { label: title },
];
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  publishedDate={pubDate}
  modifiedDate={updatedDate}
  author={author}
  keywords={tags}
  schema={[
    articleSchema({
      title,
      description,
      path,
      author,
      pubDate,
      updatedDate,
      section: category,
      keywords: tags,
    }),
    ...reviewSchemas({
      title,
      description,
      path,
      author,
      pubDate,
      updatedDate,
      section: category,
      rating,
      items: tools.map((tool) => ({
        name: tool.name,
        url: tool.url,
        vendor: tool.vendor,
        rating: tool.rating,
      })),
    }),
    breadcrumbSchema(crumbs),
  ]}
>
  <div class="container-page py-10 lg:py-14">
    <Breadcrumbs items={crumbs} />

    <div class="mt-8 grid gap-12 lg:grid-cols-[minmax(0,1fr)_16rem]">
      <article class="min-w-0">
        <header class="border-b border-border-subtle pb-8">
          <div class="flex flex-wrap items-center gap-3">
            <Badge variant="brand">{category}</Badge>
            <RatingStars rating={rating} />
          </div>
          <h1
            class="mt-4 text-3xl font-extrabold leading-tight tracking-tight text-balance text-ink sm:text-4xl"
          >
            {title}
          </h1>
          <p class="mt-4 text-lg leading-relaxed text-pretty text-ink-muted">{description}</p>
          <div class="mt-5 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-ink-muted">
            <span class="font-medium text-ink">{author}</span>
            <span aria-hidden="true">·</span>
            <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
            {updatedDate && (
              <>
                <span aria-hidden="true">·</span>
                <span>Updated {formatDate(updatedDate)}</span>
              </>
            )}
            <span aria-hidden="true">·</span>
            <span>{minutes} min read</span>
          </div>
        </header>

        <VerdictBox verdict={verdict} summary={summary} rating={rating} />

        {comparison.length > 0 && (
          <ComparisonTable
            columns={columns}
            rows={comparison}
            caption={`${columns[0]} vs ${columns[1]} — feature-by-feature, scored by our editors.`}
          />
        )}

        <AdSlot slot="displayHorizontal" format="horizontal" />

        <ProsCons tools={tools} />

        <div
          class="prose prose-devtoolsdk mt-10 max-w-none prose-headings:font-bold prose-headings:tracking-tight prose-a:font-medium prose-a:underline-offset-2 prose-img:rounded-xl"
        >
          <slot />
        </div>

        <AdSlot slot="inArticle" format="fluid" layout="in-article" />

        <section
          class="mt-12 rounded-[var(--radius-card)] border border-accent/30 bg-accent-soft/60 p-6 text-center sm:p-8"
        >
          <h2 class="text-xl font-extrabold tracking-tight text-balance text-ink">
            Still weighing {columns[0]} against {columns[1]}?
          </h2>
          <p class="mx-auto mt-2 max-w-xl text-sm leading-relaxed text-ink-muted">
            Every comparison on DevToolSDK follows the same scoring rubric, so you can line two of
            them up and trust the numbers.
          </p>
          <div class="mt-6 flex flex-col items-center justify-center gap-3 sm:flex-row">
            <CTAButton href="/reviews" event="review_cta_primary">See every comparison</CTAButton>
            <CTAButton href="/about#methodology" variant="secondary" event="review_cta_method">
              How we score
            </CTAButton>
          </div>
        </section>

        {tags.length > 0 && (
          <ul class="mt-10 flex flex-wrap gap-2 border-t border-border-subtle pt-6">
            {tags.map((tag) => (
              <li>
                <Badge variant="neutral">#{tag}</Badge>
              </li>
            ))}
          </ul>
        )}

        <section class="card-surface mt-12 p-6 sm:p-8">
          <h2 class="text-lg font-bold text-ink">Get the next comparison in your inbox</h2>
          <p class="mt-1.5 text-sm text-ink-muted">
            One email a month, written after the trial period ends — not during it.
          </p>
          <div class="mt-5"><Newsletter /></div>
        </section>
      </article>

      <aside class="min-w-0">
        <TableOfContents headings={headings} />
      </aside>
    </div>

    {related.length > 0 && (
      <section class="mt-20 border-t border-border-subtle pt-12">
        <h2 class="text-2xl font-extrabold tracking-tight text-ink">Related comparisons</h2>
        <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {related.map((item) => (
            <ReviewCard review={item} />
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>
