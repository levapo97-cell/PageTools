---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { breadcrumbSchema } from '@/lib/schema';
import { formatDate } from '@/lib/format';
import { LEGAL, LEGAL_LINKS } from '@/consts';

interface Props {
  title: string;
  description: string;
  path: string;
  lead: string;
}

const { title, description, path, lead } = Astro.props;

const crumbs = [
  { href: '/', label: 'Home' },
  { label: title },
];

const effective = new Date(LEGAL.effectiveDate);
---

<BaseLayout
  title={title}
  description={description}
  schema={[
    breadcrumbSchema(crumbs),
    {
      '@type': 'WebPage',
      name: title,
      description,
      url: new URL(path, Astro.site).toString(),
      dateModified: effective.toISOString(),
    },
  ]}
>
  <div class="container-page py-10 lg:py-14">
    <Breadcrumbs items={crumbs} />

    <div class="mt-8 grid gap-12 lg:grid-cols-[minmax(0,1fr)_15rem]">
      <article class="min-w-0 max-w-[var(--container-content)]">
        <header class="border-b border-border-subtle pb-8">
          <h1 class="text-3xl font-extrabold tracking-tight text-balance text-ink sm:text-4xl">
            {title}
          </h1>
          <p class="mt-4 text-lg leading-relaxed text-pretty text-ink-muted">{lead}</p>
          <p class="mt-5 text-sm text-ink-muted">
            Effective <time datetime={LEGAL.effectiveDate}>{formatDate(effective)}</time>
          </p>
        </header>

        <div
          class="prose prose-pagetools mt-10 max-w-none prose-headings:font-bold prose-headings:tracking-tight prose-a:font-medium prose-a:underline-offset-2"
        >
          <slot />
        </div>
      </article>

      <aside class="min-w-0">
        <nav aria-label="Policies" class="card-surface p-5 lg:sticky lg:top-24">
          <h2 class="text-xs font-bold uppercase tracking-[0.18em] text-ink">Policies</h2>
          <ul class="mt-3 space-y-1.5 text-sm">
            {LEGAL_LINKS.map((link) => (
              <li>
                <a
                  href={link.href}
                  aria-current={link.href === path ? 'page' : undefined}
                  class:list={[
                    'block transition-colors hover:text-accent',
                    link.href === path ? 'font-semibold text-accent' : 'text-ink-muted',
                  ]}
                >
                  {link.label}
                </a>
              </li>
            ))}
            <li>
              <a href="/about#methodology" class="block text-ink-muted transition-colors hover:text-accent">
                Editorial methodology
              </a>
            </li>
            <li>
              <a href="/contact" class="block text-ink-muted transition-colors hover:text-accent">
                Contact us
              </a>
            </li>
          </ul>
        </nav>
      </aside>
    </div>
  </div>
</BaseLayout>
