---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import ReviewCard from '@/components/ReviewCard.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import CTAButton from '@/components/CTAButton.astro';
import AdSlot from '@/components/AdSlot.astro';
import Newsletter from '@/components/Newsletter.astro';
import { getReviews, getArticles, getFeaturedReviews, categoriesOf } from '@/lib/content';
import { SITE } from '@/consts';

const reviews = await getReviews();
const articles = await getArticles();
const featured = await getFeaturedReviews(3);
const latest = reviews.slice(0, 6);
const categories = categoriesOf(reviews).slice(0, 8);

const pillars = [
  {
    title: 'We run the tools, not the demos',
    body: 'Every comparison starts with a real project migrated onto both options — the same app, the same team, the same deadline.',
  },
  {
    title: 'One rubric, every review',
    body: 'Pricing, lock-in, developer experience, ecosystem and operational cost. Same weights each time, so scores are comparable.',
  },
  {
    title: 'Nobody buys a ranking',
    body: 'Affiliate links exist and are labelled. They have never moved a score, and vendors see the review when you do.',
  },
];
---

<BaseLayout title={SITE.name} description={SITE.description}>
  <Hero reviewCount={reviews.length} articleCount={articles.length} />

  <section class="container-page py-16 sm:py-20">
    <SectionHeading
      eyebrow="Featured"
      title="Start with these comparisons"
      description="The decisions teams ask us about most — settled with numbers instead of vibes."
    />
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {featured.map((review) => (
        <ReviewCard review={review} featured />
      ))}
    </div>
  </section>

  <AdSlot slot="displayHorizontal" format="horizontal" class="container-page" />

  <section class="border-y border-border-subtle bg-surface-muted py-16 sm:py-20">
    <div class="container-page">
      <SectionHeading
        eyebrow="Why PageTools"
        title="Reviews you can actually act on"
        align="center"
      />
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {pillars.map((pillar, index) => (
          <div class="card-surface p-6">
            <span
              class="grid size-9 place-items-center rounded-lg bg-accent-soft font-extrabold text-accent"
              aria-hidden="true"
            >
              {index + 1}
            </span>
            <h3 class="mt-4 text-base font-bold text-ink">{pillar.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-muted">{pillar.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="container-page py-16 sm:py-20">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <SectionHeading eyebrow="Latest" title="Fresh off the test bench" />
      <CTAButton href="/reviews" variant="ghost" event="home_all_reviews">
        View all {reviews.length} reviews →
      </CTAButton>
    </div>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {latest.map((review) => (
        <ReviewCard review={review} />
      ))}
    </div>
  </section>

  {categories.length > 0 && (
    <section class="container-page pb-4">
      <h2 class="text-xs font-bold uppercase tracking-[0.18em] text-ink-muted">Browse by category</h2>
      <ul class="mt-4 flex flex-wrap gap-2">
        {categories.map((category) => (
          <li>
            <a
              href={`/reviews#${category.name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}
              class="inline-flex items-center gap-2 rounded-full border border-border-subtle bg-surface-raised px-3.5 py-1.5 text-sm text-ink-muted transition-colors hover:border-accent hover:text-accent"
            >
              {category.name}
              <span class="text-xs text-ink-muted/70">{category.count}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {articles.length > 0 && (
    <section class="container-page py-16 sm:py-20">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <SectionHeading eyebrow="From the blog" title="Guides and deep dives" />
        <CTAButton href="/articles" variant="ghost" event="home_all_articles">
          All articles →
        </CTAButton>
      </div>
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {articles.slice(0, 3).map((article) => (
          <ArticleCard article={article} />
        ))}
      </div>
    </section>
  )}

  <section class="container-page pb-20">
    <div
      class="overflow-hidden rounded-[var(--radius-card)] bg-gradient-to-br from-brand-700 via-brand-600 to-brand-900 px-6 py-14 text-center sm:px-12"
    >
      <h2 class="text-2xl font-extrabold tracking-tight text-balance text-white sm:text-3xl">
        One email a month. The comparison you were about to Google.
      </h2>
      <p class="mx-auto mt-3 max-w-xl text-sm leading-relaxed text-brand-100">
        Join the developers and platform leads who let us do the trial-and-error first.
      </p>
      <div class="mx-auto mt-8 flex max-w-md justify-center [&_label]:text-white [&_p]:text-brand-100">
        <Newsletter />
      </div>
    </div>
  </section>
</BaseLayout>
