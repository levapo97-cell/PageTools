---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import ToolCard from '@/components/ToolCard.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import CTAButton from '@/components/CTAButton.astro';
import AdSlot from '@/components/AdSlot.astro';
import Newsletter from '@/components/Newsletter.astro';
import { getGuides, getArticles, pathOf } from '@/lib/content';
import { SITE } from '@/consts';

const guides = await getGuides();
const articles = await getArticles();
const chapterCount = guides.reduce((sum, guide) => sum + guide.sections.length, 0);

const pillars = [
  {
    title: 'The mental model comes first',
    body: 'Chapter one is never installation. It is the problem the tool was built to solve, because everything else only makes sense once you have that.',
  },
  {
    title: 'Every command is run before it is published',
    body: 'Each guide states the exact version it was verified against. If a command in here fails for you, it is a bug and we want to hear about it.',
  },
  {
    title: 'The mistakes chapter is the point',
    body: 'Official docs describe what the tool does. We wrote down what everybody gets wrong on the way there, which is where the time actually goes.',
  },
];
---

<BaseLayout title={SITE.name} description={SITE.description}>
  <Hero
    guideCount={guides.length}
    chapterCount={chapterCount}
    articleCount={articles.length}
  />

  <section class="container-page py-16 sm:py-20">
    <SectionHeading
      eyebrow="The guides"
      title="Pick a tool and start at chapter one"
      description="Each guide is a curriculum, not a reference. Read it in order once, then come back to the chapters you need."
    />
    <div class="mt-8 grid gap-6 md:grid-cols-2">
      {guides.map((guide) => (
        <ToolCard guide={guide} />
      ))}
    </div>
  </section>

  <AdSlot slot="displayHorizontal" format="horizontal" class="container-page" />

  <section class="border-y border-border-subtle bg-surface-muted py-16 sm:py-20">
    <div class="container-page">
      <SectionHeading eyebrow="How these differ" title="Why another set of tutorials" align="center" />
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {pillars.map((pillar, index) => (
          <div class="card-surface p-6">
            <span
              class="grid size-9 place-items-center rounded-lg bg-accent-soft font-extrabold text-accent"
              aria-hidden="true"
            >
              {index + 1}
            </span>
            <h3 class="mt-4 text-base font-bold text-ink">{pillar.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-muted">{pillar.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {guides.length > 0 && (
    <section class="container-page py-16 sm:py-20">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <SectionHeading eyebrow="Start here" title="If you only read one chapter" />
        <CTAButton href="/guides" variant="ghost" event="home_all_guides">
          All {guides.length} guides →
        </CTAButton>
      </div>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2">
        {guides.map((guide) => {
          const opener = guide.sections[0];
          return opener ? (
            <li>
              <a
                href={pathOf(opener)}
                class="group card-surface flex h-full flex-col p-5 transition-all hover:-translate-y-0.5 hover:border-accent/40"
              >
                <span class="text-xs font-bold uppercase tracking-wider text-accent">
                  {guide.tool.name}
                </span>
                <span class="mt-2 font-bold text-ink transition-colors group-hover:text-accent">
                  {opener.data.title}
                </span>
                <span class="mt-1.5 text-sm leading-relaxed text-ink-muted">
                  {opener.data.description}
                </span>
              </a>
            </li>
          ) : null;
        })}
      </ul>
    </section>
  )}

  {articles.length > 0 && (
    <section class="container-page pb-16 sm:pb-20">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <SectionHeading eyebrow="From the blog" title="Deep dives and field notes" />
        <CTAButton href="/articles" variant="ghost" event="home_all_articles">
          All articles →
        </CTAButton>
      </div>
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {articles.slice(0, 3).map((article) => (
          <ArticleCard article={article} />
        ))}
      </div>
    </section>
  )}

  <section class="container-page pb-20">
    <div
      class="overflow-hidden rounded-[var(--radius-card)] bg-gradient-to-br from-brand-700 via-brand-600 to-brand-900 px-6 py-14 text-center sm:px-12"
    >
      <h2 class="text-2xl font-extrabold tracking-tight text-balance text-white sm:text-3xl">
        One email a month, when a new guide ships.
      </h2>
      <p class="mx-auto mt-3 max-w-xl text-sm leading-relaxed text-brand-100">
        No drip sequence, no upsell, no course. Just the guide.
      </p>
      <div class="mx-auto mt-8 flex max-w-md justify-center [&_label]:text-white [&_p]:text-brand-100">
        <Newsletter />
      </div>
    </div>
  </section>
</BaseLayout>
