---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CTAButton from '@/components/CTAButton.astro';
---

<BaseLayout
  title="Page not found"
  description="That page does not exist — but the comparison you were after probably does."
  noindex
>
  <div class="container-page flex min-h-[60vh] flex-col items-center justify-center py-20 text-center">
    <p class="text-7xl font-extrabold tracking-tight text-accent sm:text-8xl">404</p>
    <h1 class="mt-4 text-2xl font-extrabold tracking-tight text-balance text-ink sm:text-3xl">
      That page moved, or never existed
    </h1>
    <p class="mt-3 max-w-md text-pretty text-ink-muted">
      The comparison you were looking for is probably still here — it may just have a different
      slug now.
    </p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <CTAButton href="/guides" event="404_guides">Browse all guides</CTAButton>
      <CTAButton href="/" variant="secondary" event="404_home">Back to home</CTAButton>
    </div>
  </div>
</BaseLayout>
