---
import { render } from 'astro:content';
import ReviewLayout from '@/layouts/ReviewLayout.astro';
import { getReviews, relatedTo, type Review } from '@/lib/content';

export async function getStaticPaths() {
  const reviews = await getReviews();
  return reviews.map((review) => ({
    params: { slug: review.id },
    props: { review, pool: reviews },
  }));
}

interface Props {
  review: Review;
  pool: Review[];
}

const { review, pool } = Astro.props;
const { Content, headings } = await render(review);
const related = relatedTo(review, pool, 3);
---

<ReviewLayout review={review} headings={headings} related={related}>
  <Content />
</ReviewLayout>
