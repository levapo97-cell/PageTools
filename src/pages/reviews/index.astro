---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ReviewCard from '@/components/ReviewCard.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import AdSlot from '@/components/AdSlot.astro';
import { getReviews, categoriesOf } from '@/lib/content';
import { collectionPageSchema, breadcrumbSchema } from '@/lib/schema';

const reviews = await getReviews();
const categories = categoriesOf(reviews);
const slugify = (value: string) => value.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

const grouped = categories.map((category) => ({
  ...category,
  slug: slugify(category.name),
  items: reviews.filter((review) => review.data.category === category.name),
}));

const title = 'SaaS tool reviews and head-to-head comparisons';
const description =
  'Every PageTools comparison in one place — infrastructure, CI/CD, hosting, containers, databases and frameworks, each scored against the same rubric.';

const crumbs = [
  { href: '/', label: 'Home' },
  { label: 'Reviews' },
];
---

<BaseLayout
  title={title}
  description={description}
  keywords={['saas reviews', 'devops tools comparison', 'developer tools']}
  schema={[
    collectionPageSchema({
      title,
      description,
      path: '/reviews',
      items: reviews.map((review) => ({
        title: review.data.title,
        path: `/reviews/${review.id}`,
      })),
    }),
    breadcrumbSchema(crumbs),
  ]}
>
  <div class="container-page py-10 lg:py-14">
    <Breadcrumbs items={crumbs} />

    <div class="mt-8">
      <SectionHeading
        eyebrow={`${reviews.length} comparisons`}
        title="Reviews"
        description={description}
      />
    </div>

    <nav aria-label="Categories" class="mt-8 flex flex-wrap gap-2">
      {grouped.map((category) => (
        <a
          href={`#${category.slug}`}
          class="inline-flex items-center gap-2 rounded-full border border-border-subtle bg-surface-raised px-3.5 py-1.5 text-sm text-ink-muted transition-colors hover:border-accent hover:text-accent"
        >
          {category.name}
          <span class="text-xs text-ink-muted/70">{category.count}</span>
        </a>
      ))}
    </nav>

    <AdSlot slot="displayHorizontal" format="horizontal" />

    {grouped.map((category, index) => (
      <section id={category.slug} class="mt-14 scroll-mt-24">
        <h2 class="text-xl font-extrabold tracking-tight text-ink">
          {category.name}
          <span class="ml-2 text-sm font-medium text-ink-muted">({category.count})</span>
        </h2>
        <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {category.items.map((review) => (
            <ReviewCard review={review} />
          ))}
        </div>
        {index === 1 && <AdSlot slot="inArticle" format="fluid" layout="in-feed" />}
      </section>
    ))}

    {reviews.length === 0 && (
      <p class="mt-12 text-ink-muted">No reviews published yet. Check back shortly.</p>
    )}
  </div>
</BaseLayout>
