---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { breadcrumbSchema } from '@/lib/schema';
import { SITE, FORMS } from '@/consts';

const title = 'Contact PageTools';
const description =
  'Suggest a tool comparison, report a factual error, or talk to us about advertising. We read every message and reply to most within two business days.';

const crumbs = [
  { href: '/', label: 'Home' },
  { label: 'Contact' },
];

const endpoint = FORMS.contactEndpoint;

const reasons = [
  { value: 'suggestion', label: 'Suggest a comparison' },
  { value: 'correction', label: 'Report a factual error' },
  { value: 'advertising', label: 'Advertising & sponsorship' },
  { value: 'other', label: 'Something else' },
];
---

<BaseLayout
  title={title}
  description={description}
  schema={[
    breadcrumbSchema(crumbs),
    {
      '@type': 'ContactPage',
      name: title,
      description,
      url: new URL('/contact', Astro.site).toString(),
    },
  ]}
>
  <div class="container-page py-10 lg:py-14">
    <Breadcrumbs items={crumbs} />

    <div class="mt-8 grid gap-12 lg:grid-cols-[minmax(0,1fr)_20rem]">
      <div>
        <h1 class="text-3xl font-extrabold tracking-tight text-balance text-ink sm:text-4xl">
          Tell us what to test next
        </h1>
        <p class="mt-4 max-w-2xl text-lg leading-relaxed text-pretty text-ink-muted">
          {description}
        </p>

        <form
          class="card-surface mt-10 space-y-5 p-6 sm:p-8"
          action={endpoint || undefined}
          method="post"
          data-contact
          novalidate
        >
          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="name" class="mb-1.5 block text-sm font-semibold text-ink">Name</label>
              <input
                id="name"
                name="name"
                type="text"
                required
                autocomplete="name"
                class="w-full rounded-lg border border-border-subtle bg-surface px-3.5 py-2.5 text-sm text-ink placeholder:text-ink-muted/70 focus:border-accent focus:outline-none"
                placeholder="Ada Lovelace"
              />
            </div>
            <div>
              <label for="email" class="mb-1.5 block text-sm font-semibold text-ink">Email</label>
              <input
                id="email"
                name="email"
                type="email"
                required
                autocomplete="email"
                class="w-full rounded-lg border border-border-subtle bg-surface px-3.5 py-2.5 text-sm text-ink placeholder:text-ink-muted/70 focus:border-accent focus:outline-none"
                placeholder="you@company.com"
              />
            </div>
          </div>

          <div>
            <label for="reason" class="mb-1.5 block text-sm font-semibold text-ink">
              What is this about?
            </label>
            <select
              id="reason"
              name="reason"
              class="w-full rounded-lg border border-border-subtle bg-surface px-3.5 py-2.5 text-sm text-ink focus:border-accent focus:outline-none"
            >
              {reasons.map((reason) => (
                <option value={reason.value}>{reason.label}</option>
              ))}
            </select>
          </div>

          <div>
            <label for="message" class="mb-1.5 block text-sm font-semibold text-ink">Message</label>
            <textarea
              id="message"
              name="message"
              rows="6"
              required
              minlength="20"
              class="w-full rounded-lg border border-border-subtle bg-surface px-3.5 py-2.5 text-sm text-ink placeholder:text-ink-muted/70 focus:border-accent focus:outline-none"
              placeholder="We are choosing between … and the thing we cannot work out is …"></textarea>
          </div>

          {/* Honeypot — bots fill it, humans never see it. */}
          <div class="hidden" aria-hidden="true">
            <label for="company-website">Leave this field empty</label>
            <input id="company-website" name="company-website" type="text" tabindex="-1" autocomplete="off" />
          </div>

          <div class="flex flex-wrap items-center gap-4">
            <button
              type="submit"
              class="rounded-lg bg-brand-600 px-6 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-brand-800 dark:bg-brand-500 dark:hover:bg-brand-400 dark:hover:text-brand-950"
            >
              Send message
            </button>
            <p class="text-sm text-ink-muted" role="status" data-contact-status></p>
          </div>
        </form>
      </div>

      <aside class="space-y-6">
        <div class="card-surface p-6">
          <h2 class="text-sm font-bold uppercase tracking-wider text-ink">Prefer email?</h2>
          <a
            href={`mailto:${SITE.email}`}
            class="mt-3 block text-sm font-medium text-accent hover:underline"
          >
            {SITE.email}
          </a>
          <p class="mt-3 text-sm leading-relaxed text-ink-muted">
            Corrections get priority. Include the URL and what we got wrong, and we will fix it or
            explain why we disagree.
          </p>
        </div>

        <div class="card-surface p-6">
          <h2 class="text-sm font-bold uppercase tracking-wider text-ink">Response times</h2>
          <ul class="mt-3 space-y-2 text-sm text-ink-muted">
            <li>Corrections — within 1 business day</li>
            <li>Comparison suggestions — within 2 business days</li>
            <li>Advertising — within 3 business days</li>
          </ul>
        </div>

        <div class="card-surface p-6">
          <h2 class="text-sm font-bold uppercase tracking-wider text-ink">What we cannot do</h2>
          <p class="mt-3 text-sm leading-relaxed text-ink-muted">
            We do not sell placement in a comparison, adjust a score after publication on request,
            or publish vendor-written copy. That is the whole point of the site.
          </p>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<script>
  function setUp() {
    const form = document.querySelector<HTMLFormElement>('form[data-contact]');
    if (!form || form.dataset.bound === 'true') return;
    form.dataset.bound = 'true';

    const status = form.querySelector<HTMLElement>('[data-contact-status]');
    const mailto = 'hello@pagetools.dev';

    form.addEventListener('submit', async (event) => {
      if (!form.checkValidity()) {
        event.preventDefault();
        form.reportValidity();
        return;
      }

      const honeypot = form.querySelector<HTMLInputElement>('input[name="company-website"]');
      if (honeypot?.value) {
        event.preventDefault();
        return;
      }

      // No endpoint configured yet: fall back to the user's mail client instead
      // of posting the message into a void.
      if (!form.getAttribute('action')) {
        event.preventDefault();
        const data = new FormData(form);
        const subject = encodeURIComponent(`[PageTools] ${String(data.get('reason') ?? 'contact')}`);
        const body = encodeURIComponent(
          `${String(data.get('message') ?? '')}\n\n— ${String(data.get('name') ?? '')} <${String(data.get('email') ?? '')}>`,
        );
        window.location.href = `mailto:${mailto}?subject=${subject}&body=${body}`;
        if (status) status.textContent = 'Opening your mail client…';
        return;
      }

      event.preventDefault();
      if (status) status.textContent = 'Sending…';
      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        });
        if (!response.ok) throw new Error(String(response.status));
        form.reset();
        if (status) status.textContent = 'Thanks — we will get back to you shortly.';
      } catch {
        if (status) status.textContent = `Something went wrong. Email us at ${mailto} instead.`;
      }
    });
  }

  setUp();
  document.addEventListener('astro:after-swap', setUp);
</script>
