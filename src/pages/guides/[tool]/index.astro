---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import DocsSidebar from '@/components/DocsSidebar.astro';
import CTAButton from '@/components/CTAButton.astro';
import Badge from '@/components/Badge.astro';
import AdSlot from '@/components/AdSlot.astro';
import Newsletter from '@/components/Newsletter.astro';
import { getGuides, pathOf, type Guide } from '@/lib/content';
import { breadcrumbSchema, howToSchema } from '@/lib/schema';
import { readingTime } from '@/lib/format';

export async function getStaticPaths() {
  const guides = await getGuides();
  return guides.map((guide) => ({
    params: { tool: guide.tool.slug },
    props: { guide },
  }));
}

interface Props {
  guide: Guide;
}

const { guide } = Astro.props;
const { tool, sections } = guide;
const path = `/guides/${tool.slug}`;
const first = sections[0];

const crumbs = [
  { href: '/', label: 'Home' },
  { href: '/guides', label: 'Guides' },
  { label: tool.name },
];

const difficultyVariant = {
  Beginner: 'success',
  Intermediate: 'warning',
  Advanced: 'brand',
} as const;
---

<BaseLayout
  title={`${tool.name} guide`}
  description={tool.description}
  keywords={[`${tool.name.toLowerCase()} tutorial`, `learn ${tool.name.toLowerCase()}`]}
  schema={[
    howToSchema({
      title: `How to learn ${tool.name}`,
      description: tool.description,
      path,
      totalTime: tool.duration,
      steps: sections.map((section) => ({
        name: section.data.title,
        text: section.data.description,
        url: pathOf(section),
      })),
    }),
    breadcrumbSchema(crumbs),
  ]}
>
  <div class="container-page py-8 lg:py-12">
    <div class="grid gap-10 lg:grid-cols-[15rem_minmax(0,1fr)]">
      <aside class="min-w-0">
        <div class="hidden lg:block"><DocsSidebar guide={guide} current={path} /></div>
      </aside>

      <div class="min-w-0">
        <Breadcrumbs items={crumbs} />

        <header class="mt-6">
          <div class="flex flex-wrap items-center gap-2">
            <Badge variant="neutral">{tool.category}</Badge>
            <Badge variant={difficultyVariant[tool.difficulty]}>{tool.difficulty}</Badge>
            <Badge variant="neutral">v{tool.version}</Badge>
          </div>
          <h1
            class="mt-4 text-4xl font-extrabold leading-tight tracking-tight text-balance text-ink sm:text-5xl"
          >
            Learn {tool.name}
          </h1>
          <p class="mt-3 text-xl font-medium text-pretty text-ink-muted">{tool.tagline}</p>
          <p class="mt-5 max-w-2xl text-lg leading-relaxed text-pretty text-ink-muted">
            {tool.description}
          </p>

          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            {first && (
              <CTAButton href={pathOf(first)} size="lg" event={`guide_start_${tool.slug}`}>
                Start with chapter 1
              </CTAButton>
            )}
            <CTAButton href={tool.docsUrl} variant="secondary" size="lg" external>
              Official docs
            </CTAButton>
          </div>

          <dl class="mt-8 flex flex-wrap gap-x-8 gap-y-2 border-y border-border-subtle py-4 text-sm">
            <div class="flex gap-2">
              <dt class="text-ink-muted">Chapters</dt>
              <dd class="font-semibold text-ink">{sections.length}</dd>
            </div>
            <div class="flex gap-2">
              <dt class="text-ink-muted">Total time</dt>
              <dd class="font-semibold text-ink">~{tool.duration} min</dd>
            </div>
            <div class="flex gap-2">
              <dt class="text-ink-muted">Level</dt>
              <dd class="font-semibold text-ink">{tool.difficulty}</dd>
            </div>
          </dl>
        </header>

        <AdSlot slot="displayHorizontal" format="horizontal" />

        <section class="mt-10">
          <h2 class="text-2xl font-extrabold tracking-tight text-ink">The curriculum</h2>
          <p class="mt-2 text-ink-muted">
            Written to be read in order. Each chapter assumes the one before it.
          </p>

          <ol class="mt-6 space-y-3">
            {sections.map((section, index) => (
              <li>
                <a
                  href={pathOf(section)}
                  class="group card-surface flex gap-4 p-5 transition-all hover:-translate-y-0.5 hover:border-accent/40"
                >
                  <span
                    class="grid size-9 shrink-0 place-items-center rounded-lg bg-accent-soft text-sm font-extrabold text-accent"
                    aria-hidden="true"
                  >
                    {index + 1}
                  </span>
                  <span class="min-w-0">
                    <span class="block font-bold text-ink transition-colors group-hover:text-accent">
                      {section.data.title}
                    </span>
                    <span class="mt-1 block text-sm leading-relaxed text-ink-muted">
                      {section.data.description}
                    </span>
                    <span class="mt-2 block text-xs text-ink-muted">
                      {readingTime(section.body)} min read
                    </span>
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </section>

        <section class="card-surface mt-12 p-6 sm:p-8">
          <h2 class="text-lg font-bold text-ink">Tell us which guide to write next</h2>
          <p class="mt-1.5 text-sm text-ink-muted">
            One email a month when a new guide ships. Nothing else.
          </p>
          <div class="mt-5"><Newsletter /></div>
        </section>
      </div>
    </div>
  </div>
</BaseLayout>
