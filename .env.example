# Canonical origin, no trailing slash. Drives canonical tags, Open Graph, sitemap and RSS.
PUBLIC_SITE_URL="https://pagetools.dev"

# Google AdSense publisher id. Leave empty to strip every ad slot from the build.
PUBLIC_ADSENSE_CLIENT=""

# Emit the AdSense script tag. Keep this "false" in preview/staging environments —
# Google does not allow ads to be served from non-approved hosts.
PUBLIC_ADSENSE_ENABLED="false"

# Contact + newsletter form endpoint (Formspree, Web3Forms, Buttondown, …).
# Leave empty and the contact form degrades to a mailto: link.
PUBLIC_CONTACT_ENDPOINT=""
PUBLIC_NEWSLETTER_ENDPOINT=""
